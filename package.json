{
  "name": "@stats-forge/card-kit",
  "version": "0.1.1",
  "description": "The frame, themes, text and api boundary the stats-forge cards are drawn with",
  "keywords": [
    "card-generator",
    "cards",
    "stats-forge",
    "svg"
  ],
  "homepage": "https://github.com/stats-forge/card-kit",
  "bugs": {
    "url": "https://github.com/stats-forge/card-kit/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Marco Pasqualetti",
    "url": "https://github.com/marcalexiei"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stats-forge/card-kit.git"
  },
  "files": [
    "build",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./build/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "lint:ci": "oxlint --format=github",
    "lint:fix": "oxlint --fix",
    "lint:knip": "knip",
    "lint:publish": "attw --pack . --profile node16 --ignore-rules cjs-resolves-to-esm && publint --strict",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check-all": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run lint:knip && pnpm run test:coverage && pnpm run build && pnpm run lint:publish",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@marcalexiei/oxfmt-config": "2.0.1",
    "@marcalexiei/oxlint-config": "1.9.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "26.6.6",
    "@uppercod/css-to-object": "1.1.1",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "31.0.0",
    "knip": "6.45.0",
    "lefthook": "2.2.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^24 || >=26"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
